# Neon PostgreSQL connection string
# Dashboard → Project → Connection details → URI (use pooled / -pooler for Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth (Vercel에서도 필수). 생성 예: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"

# 로컬
AUTH_URL="http://localhost:3000"

# Vercel 배포 후 (예: https://your-app.vercel.app)
# AUTH_URL="https://your-app.vercel.app"
